node-linker=hoisted
link-workspace-packages=true

# GitHub Packages registry configuration for React Native Google Sign-In
# Uncomment and set NPM_TOKEN_GOOGLE_SIGN_IN if using @react-native-google-signin from GitHub Packages
# //npm.pkg.github.com/:_authToken=${NPM_TOKEN_GOOGLE_SIGN_IN}
# @react-native-google-signin:registry=https://npm.pkg.github.com/