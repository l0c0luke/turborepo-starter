# Keep the Docker build context lean. All workspace package.json files and
# source must remain so `turbo prune` (apps/nextjs/Dockerfile) can compute the
# pruned workspace; only build artifacts, installed deps, native project dirs
# and secrets are excluded.
**/node_modules
**/.next
**/dist
**/.cache
**/.turbo
**/.expo
.git
.github
**/.env
**/.env.*
.env
!.env.example
out
coverage
apps/expo/ios
apps/expo/android
*.log
Dockerfile
**/Dockerfile
.dockerignore
