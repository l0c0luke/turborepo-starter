{
  "name": "@example-app/expo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "git clean -xdf .cache .expo .turbo android ios node_modules",
    "dev": "pnpm with-env expo start",
    "android": "pnpm with-env expo run:android",
    "ios": "pnpm with-env expo run:ios",
    "check:expo": "expo install --check",
    "typecheck": "tsc --noEmit",
    "with-env": "dotenv -e ../../.env --"
  },
  "dependencies": {
    "@better-auth/expo": "catalog:",
    "@example-app/api": "workspace:*",
    "@example-app/shared": "workspace:*",
    "@expo/dom-webview": "catalog:",
    "@expo/metro-runtime": "catalog:",
    "@expo/vector-icons": "catalog:",
    "@react-native-community/datetimepicker": "catalog:",
    "@react-native-google-signin/google-signin": "catalog:",
    "@sentry/react-native": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@trpc/client": "catalog:",
    "@trpc/server": "catalog:",
    "@trpc/tanstack-react-query": "catalog:",
    "better-auth": "catalog:",
    "expo": "catalog:",
    "expo-apple-authentication": "catalog:",
    "expo-constants": "catalog:",
    "expo-crypto": "catalog:",
    "expo-dev-client": "catalog:",
    "expo-font": "catalog:",
    "expo-linking": "catalog:",
    "expo-router": "catalog:",
    "expo-secure-store": "catalog:",
    "expo-splash-screen": "catalog:",
    "expo-status-bar": "catalog:",
    "expo-system-ui": "catalog:",
    "expo-web-browser": "catalog:",
    "nativewind": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:",
    "react-native-css": "catalog:",
    "react-native-gesture-handler": "catalog:",
    "react-native-reanimated": "catalog:",
    "react-native-safe-area-context": "catalog:",
    "react-native-screens": "catalog:",
    "react-native-worklets": "catalog:",
    "superjson": "catalog:",
    "tailwindcss": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@example-app/tsconfig": "workspace:*",
    "@types/babel__core": "catalog:",
    "@types/react": "catalog:react19",
    "babel-preset-expo": "catalog:",
    "dotenv-cli": "catalog:",
    "typescript": "catalog:"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  }
}
