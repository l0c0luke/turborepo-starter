{
  "extends": "@example-app/tsconfig/base.json",
  "compilerOptions": {
    "lib": ["ES2023", "dom", "dom.iterable"],
    "jsx": "preserve",
    "paths": {
      "~/*": ["./src/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
    "module": "esnext",
    "types": ["node"]
  },
  "include": [".", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
