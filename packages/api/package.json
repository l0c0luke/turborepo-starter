{
  "name": "@example-app/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc",
    "test": "pnpm with-env vitest run --coverage",
    "test:watch": "pnpm with-env vitest",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "with-env": "dotenv -e ../../.env --"
  },
  "dependencies": {
    "@example-app/auth": "workspace:*",
    "@example-app/db": "workspace:*",
    "@example-app/shared": "workspace:*",
    "@example-app/validators": "workspace:*",
    "@trpc/server": "catalog:",
    "drizzle-orm": "catalog:",
    "superjson": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@example-app/prettier-config": "workspace:*",
    "@example-app/tsconfig": "workspace:*",
    "@example-app/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "dotenv-cli": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "prettier": "@example-app/prettier-config"
}
