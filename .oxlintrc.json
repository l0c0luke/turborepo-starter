{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "react", "jsx-a11y"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "env": {
    "browser": true,
    "es2024": true,
    "node": true
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/.next/**",
    "**/.expo/**",
    "**/node_modules/**",
    "**/.turbo/**",
    "**/.cache/**",
    "**/*.config.*",
    "turbo/generators/templates/**"
  ],
  "rules": {
    "no-unused-vars": [
      "error",
      { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }
    ],
    "react/react-in-jsx-scope": "off",
    "react/set-state-in-effect": "off",
    "import/no-unassigned-import": "off",
    "import/no-named-as-default-member": "off",
    "unicorn/consistent-function-scoping": "off",
    "unicorn/prefer-set-has": "off",
    "unicorn/require-module-specifiers": "off",
    "no-await-in-loop": "off",
    "no-underscore-dangle": "off",
    "typescript/no-unsafe-type-assertion": "off",
    "typescript/no-unnecessary-type-conversion": "off",
    "typescript/no-unnecessary-type-parameters": "off",
    "react/no-array-index-key": "off",
    "typescript/consistent-type-imports": [
      "warn",
      { "prefer": "type-imports", "fixStyle": "separate-type-imports" }
    ],
    "typescript/no-non-null-assertion": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": [
      "error",
      { "checksVoidReturn": { "attributes": false } }
    ],
    "typescript/no-unnecessary-condition": [
      "error",
      { "allowConstantLoopConditions": true }
    ],
    "import/consistent-type-specifier-style": ["error", "prefer-top-level"],
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "warn",
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "zod",
            "message": "Use `import { z } from 'zod/v4'` instead to ensure v4."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["apps/nextjs/src/**/*.ts", "apps/nextjs/src/**/*.tsx"],
      "excludeFiles": ["**/env.ts", "**/instrumentation.ts"],
      "rules": {
        "no-restricted-properties": [
          "error",
          {
            "object": "process",
            "property": "env",
            "message": "Use `import { env } from '~/env'` instead to ensure validated types."
          }
        ]
      }
    },
    {
      "files": ["packages/api/src/router/**/*.ts", "packages/db/src/**/*.ts"],
      "rules": {
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-return": "off",
        "typescript/no-unsafe-argument": "off"
      }
    },
    {
      "files": ["apps/expo/**/*.ts", "apps/expo/**/*.tsx"],
      "rules": {
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-return": "off",
        "typescript/no-unsafe-argument": "off",
        "typescript/no-unnecessary-condition": "off",
        "typescript/no-non-null-assertion": "warn"
      }
    },
    {
      "files": ["scripts/**", "packages/db/src/seed.ts"],
      "rules": {
        "no-restricted-properties": "off"
      }
    },
    {
      "files": [
        "apps/nextjs/src/_components/ui/**",
        "apps/expo/src/components/ui/**"
      ],
      "rules": {
        "jsx-a11y/role-has-required-aria-props": "off",
        "jsx-a11y/prefer-tag-over-role": "off",
        "jsx-a11y/no-autofocus": "off",
        "react/jsx-no-constructed-context-values": "off"
      }
    },
    {
      "files": ["apps/expo/**/*.tsx"],
      "rules": {
        "react/style-prop-object": "off",
        "jsx-a11y/no-autofocus": "off"
      }
    }
  ]
}
