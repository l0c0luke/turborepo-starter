{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    "helpers:pinGitHubActionDigests"
  ],
  "labels": ["dependencies"],
  "schedule": ["before 6am on monday"],
  "prConcurrentLimit": 10,
  "packageRules": [
    {
      "description": "Group the Expo SDK — version-locked; bump together with `pnpm -F @example-app/expo exec expo install --fix`. CI `check:expo` fails on drift",
      "matchPackageNames": [
        "expo",
        "expo-*",
        "@expo/*",
        "react-native",
        "react-native-*",
        "@react-native-community/*"
      ],
      "groupName": "expo sdk",
      "labels": ["dependencies", "expo"]
    },
    {
      "description": "Keep react/react-dom pinned to the Expo-aligned version",
      "matchPackageNames": ["react", "react-dom"],
      "groupName": "react"
    },
    {
      "description": "Stay on the Node 24 LTS line (.nvmrc, engines, Dockerfile, eas.json, @types/node). Move to the next LTS deliberately, updating all of them together",
      "matchPackageNames": ["node", "@types/node"],
      "allowedVersions": "<25"
    },
    {
      "description": "Group Radix UI primitives",
      "matchPackageNames": ["@radix-ui/*"],
      "groupName": "radix-ui"
    },
    {
      "description": "Group Sentry SDKs",
      "matchPackageNames": ["@sentry/*"],
      "groupName": "sentry"
    },
    {
      "description": "Group non-major dev dependencies into a single PR",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "dev dependencies"
    },
    {
      "description": "Flag major updates for individual review",
      "matchUpdateTypes": ["major"],
      "labels": ["dependencies", "major"]
    },
    {
      "description": "Better Auth and its CLI must stay on the same version",
      "matchPackageNames": ["better-auth", "@better-auth/*", "auth"],
      "groupName": "better-auth"
    },
    {
      "description": "vitest and its coverage provider are exact peers",
      "matchPackageNames": ["vitest", "@vitest/*", "vite"],
      "groupName": "vitest"
    },
    {
      "description": "NativeWind v5 RC and its engine must be bumped as an exact pair (see the NativeWind install guide)",
      "matchPackageNames": ["nativewind", "react-native-css"],
      "groupName": "nativewind"
    },
    {
      "description": "lightningcss is pinned for NativeWind v5 (pnpm-workspace.yaml overrides) — bump only alongside a NativeWind upgrade",
      "matchPackageNames": ["lightningcss"],
      "enabled": false
    },
    {
      "description": "Local dev services in docker-compose.yml (and the CI Postgres service)",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["postgres", "axllent/mailpit", "bugsink/bugsink"],
      "groupName": "local dev services"
    },
    {
      "description": "Terraform: providers, modules and the CLI version (infra/.terraform-version) in one PR; lock files (.terraform.lock.hcl) refresh with it",
      "matchManagers": ["terraform", "terraform-version"],
      "groupName": "terraform"
    }
  ],
  "minimumReleaseAge": "3 days",
  "postUpdateOptions": ["pnpmDedupe"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "vulnerabilityAlerts": {
    "labels": ["dependencies", "security"],
    "minimumReleaseAge": null
  }
}
