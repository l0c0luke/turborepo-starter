# Since .env is gitignored, you can use .env.example to build a new `.env` file when you clone the repo.
# Keep this file up-to-date when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any secrets in it.
# If you are cloning this repo, create a copy of this file named `.env` and populate it with your secrets.

# The database URL is used to connect to your PostgreSQL database.
POSTGRES_URL="postgresql://example:example@localhost:5832/example"


# You can generate the secret via 'openssl rand -base64 32' on Unix
# @see https://www.better-auth.com/docs/installation
AUTH_SECRET='supersecret'

EMAIL_SERVER_HOST="localhost"       # For development, use MailHog (localhost)
EMAIL_SERVER_PORT="1025"            # MailHog SMTP port (587 for STARTTLS in production)
EMAIL_SERVER_USER=""                # Your SMTP username (usually your email)
EMAIL_SERVER_PASSWORD=""            # Your SMTP password or app-specific password
EMAIL_FROM="noreply@example.com"    # The "from" email address for outgoing emails

NEXT_PUBLIC_BASE_URL=http://localhost:3000
EXPO_PUBLIC_BASE_URL=http://localhost:3000

# Google OAuth Configuration
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-client-secret"
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID="your-google-web-client-id.apps.googleusercontent.com"
# Set to "true" to enable Google sign-in button on login page
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED="false"

# Apple Sign In Configuration (optional)
APPLE_TEAM_ID="your-apple-team-id"
APPLE_KEY_ID="your-apple-key-id"
APPLE_CLIENT_ID="com.example.app.web"
APPLE_APP_BUNDLE_ID="com.example.app" 
APPLE_PRIVATE_KEY=
# Set to "true" to enable Apple sign-in button on login page
NEXT_PUBLIC_APPLE_AUTH_ENABLED="false"
