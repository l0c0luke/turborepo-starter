# ============================================================================
# Environment Variables
# ============================================================================
# Copy this file to `.env` and fill in your values.
# This file is committed to version control — DO NOT put real secrets here.
#
# Required variables are marked with [REQUIRED].
# Optional variables have sensible defaults for local development.
# ============================================================================

# --- Database -----------------------------------------------------------
# [REQUIRED] PostgreSQL connection string
# Default works with the included docker-compose.yml
POSTGRES_URL="postgresql://example:example@localhost:5832/example"

# --- Authentication -----------------------------------------------------
# [REQUIRED in production] Secret key for signing auth tokens
# Generate via: openssl rand -base64 32
# Optional in development (empty is treated as unset); production refuses
# to start without it.
# @see https://www.better-auth.com/docs/installation
AUTH_SECRET=""

# --- App URLs -----------------------------------------------------------
# [REQUIRED] Base URL for the web app (used by auth callbacks and API)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
# [REQUIRED] Base URL the mobile app uses to reach the API
EXPO_PUBLIC_BASE_URL="http://localhost:3000"
# Optional comma-separated extra origins (besides NEXT_PUBLIC_BASE_URL) that
# Better Auth trusts for callbacks/redirects AND that may call /api/trpc
# cross-origin (CORS allow-list; exact http(s) origins). Unset = same-origin
# only. Native mobile apps don't need an entry. Example for Expo web in dev:
# TRUSTED_ORIGINS="http://localhost:8081"
TRUSTED_ORIGINS=""

# --- Email (SMTP) ------------------------------------------------------
# Default values work with Mailpit from docker-compose (http://localhost:8025)
EMAIL_SERVER_HOST="localhost"
EMAIL_SERVER_PORT="1025"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="noreply@example.com"
# Production: use a real provider (SendGrid, AWS SES, Postmark, etc.)
# EMAIL_SERVER_HOST="smtp.sendgrid.net"
# EMAIL_SERVER_PORT="587"
# EMAIL_SERVER_USER="apikey"
# EMAIL_SERVER_PASSWORD="SG.xxxxx"

# --- Google sign-in (optional) -------------------------------------------
# Off unless configured. Web/server: enabled when BOTH AUTH_GOOGLE_ID and
# AUTH_GOOGLE_SECRET are set (e.g. "1234-abc.apps.googleusercontent.com").
# Mobile: enabled when EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID is set — use the same
# web client ID as AUTH_GOOGLE_ID (the server verifies the app's ID token).
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=""
# iOS: the reversed iOS client ID ("com.googleusercontent.apps.…"). Adds the
# Google Sign-In config plugin to the native build (apps/expo/app.config.ts).
GOOGLE_IOS_URL_SCHEME=""

# --- Apple Sign In (optional) -------------------------------------------
# Off unless configured. Web/server: enabled when BOTH APPLE_CLIENT_ID (your
# Services ID, e.g. "com.example.app.web") and APPLE_CLIENT_SECRET are set.
# APPLE_CLIENT_SECRET is a JWT you generate from your Sign in with Apple key
# (team ID + key ID + private key); Apple caps it at 6 months, so rotate it.
# APPLE_APP_BUNDLE_ID lets the server verify ID tokens from the iOS app.
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""
APPLE_APP_BUNDLE_ID="com.example.app"
# Mobile (iOS): set to "true" to show the native Apple button. Needs the
# server config above.
EXPO_PUBLIC_APPLE_AUTH_ENABLED="false"

# --- Analytics (Google Analytics 4) -------------------------------------
# [REQUIRED in production] Every project ships with GA4 — project-init asks
# for it. Measurement IDs are public (they end up in the page), so it is fine
# to commit the real one here. Unset = no GA script (e.g. local dev).
# NEXT_PUBLIC_* values are inlined at BUILD time: pass it as a Docker build
# arg too (see DEPLOY.md).
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# --- Error tracking (Bugsink, Sentry-compatible) ------------------------
# `pnpm setup` provisions the local Bugsink (http://localhost:8000) and fills
# these in. In production, point them at your own Bugsink (or Sentry) DSNs.
# Unset = error reporting stays completely inert.
# Web (browser + server):
NEXT_PUBLIC_SENTRY_DSN=""
# Mobile:
EXPO_PUBLIC_SENTRY_DSN=""
# Source-map upload at build time (CI/release only). For Bugsink, set
# SENTRY_URL to your Bugsink and SENTRY_AUTH_TOKEN to a Bugsink API token.
# SENTRY_URL="https://bugsink.example.com"
# SENTRY_ORG="example-app"
# SENTRY_PROJECT="example-app-web"
# SENTRY_AUTH_TOKEN=""
