{
  "name": "example-app",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "pnpm@11.28.11",
  "scripts": {
    "android": "pnpm -F @example-app/expo android",
    "auth:generate": "pnpm -F @example-app/auth generate",
    "build": "turbo run build",
    "check": "pnpm lint && pnpm lint:ws && pnpm format && pnpm typecheck && pnpm test && pnpm check:deps && pnpm check:peers && pnpm check:conventions && pnpm check:expo",
    "check:audit": "pnpm audit --audit-level high",
    "check:bundle": "pnpm -F @example-app/nextjs check:bundle",
    "check:conventions": "node scripts/check-conventions.ts",
    "check:deps": "dotenv -e .env.example -- knip --no-progress",
    "check:expo": "pnpm -F @example-app/expo check:expo",
    "check:peers": "pnpm peers check",
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "turbo run clean",
    "db:generate": "pnpm -F @example-app/db generate",
    "db:migrate": "pnpm -F @example-app/db migrate",
    "db:push": "pnpm -F @example-app/db push",
    "db:seed": "pnpm -F @example-app/db seed",
    "db:studio": "pnpm -F @example-app/db studio",
    "dev": "turbo watch dev --continue",
    "dev:next": "turbo watch dev -F @example-app/nextjs...",
    "format": "prettier --check . --cache --cache-location .cache/.prettiercache",
    "format:fix": "prettier --write . --cache --cache-location .cache/.prettiercache",
    "gen:package": "turbo gen init",
    "ios": "pnpm -F @example-app/expo ios",
    "lint": "oxlint --type-aware --deny-warnings --report-unused-disable-directives",
    "lint:fix": "oxlint --type-aware --fix",
    "lint:ws": "sherif",
    "prepare": "lefthook install || true",
    "setup": "node scripts/setup.ts",
    "skills:install": "skills experimental_install",
    "skills:update": "skills update --project --yes",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck //#typecheck:root",
    "typecheck:root": "tsc --noEmit -p tsconfig.json",
    "ui-add": "turbo run ui-add"
  },
  "devDependencies": {
    "@example-app/prettier-config": "workspace:*",
    "@turbo/gen": "catalog:",
    "@types/node": "catalog:",
    "dotenv-cli": "catalog:",
    "knip": "catalog:",
    "lefthook": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "prettier": "catalog:",
    "sherif": "catalog:",
    "skills": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "prettier": "@example-app/prettier-config",
  "version": "1.0.0"
}
