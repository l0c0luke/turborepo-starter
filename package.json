{
  "name": "example-app",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "turbo run build",
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "turbo run clean",
    "auth:generate": "pnpm -F @example-app/auth generate",
    "db:generate": "turbo -F @example-app/db generate",
    "db:migrate": "turbo -F @example-app/db migrate",
    "db:push": "turbo -F @example-app/db push",
    "db:studio": "turbo -F @example-app/db studio",
    "dev": "turbo watch dev --continue",
    "dev:next": "turbo watch dev -F @example-app/nextjs...",
    "format": "turbo run format --continue -- --cache --cache-location .cache/.prettiercache",
    "format:fix": "turbo run format --continue -- --write --cache --cache-location .cache/.prettiercache",
    "lint": "turbo run lint --continue -- --cache --cache-location .cache/.eslintcache",
    "lint:fix": "turbo run lint --continue -- --fix --cache --cache-location .cache/.eslintcache",
    "lint:ws": "pnpm dlx sherif@latest",
    "postinstall": "pnpm lint:ws",
    "prepare": "lefthook install || true",
    "setup": "node scripts/setup.mjs",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "ui-add": "turbo run ui-add",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "devDependencies": {
    "@example-app/prettier-config": "workspace:*",
    "@turbo/gen": "catalog:",
    "lefthook": "catalog:",
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "prettier": "@example-app/prettier-config",
  "version": "1.0.0"
}
